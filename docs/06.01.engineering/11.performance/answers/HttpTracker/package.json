{
  "name": "http-performance-tracker",
  "version": "1.0.0",
  "description": "HTTP 性能指标采集验证工具，基于 Koa 框架模拟不同类型的资源请求，验证 GET 和 POST 请求的全链路性能指标采集",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node test.js"
  },
  "keywords": ["http", "performance", "metrics", "koa", "tracker", "resource-timing"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^12.0.0",
    "koa-static": "^5.0.0",
    "koa-cors": "^0.0.16"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}