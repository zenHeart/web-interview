{
  "name": "web-interview",
  "version": "1.0.0",
  "description": "web 面试题目汇总",
  "private": true,
  "scripts": {
    "sync:index": "node scripts/sync-search-index.js",
    "prestart": "node scripts/sync-search-index.js",
    "predev": "node scripts/sync-search-index.js",
    "postbuild": "node scripts/sync-search-index.js",
    "docusaurus": "docusaurus",
    "dev": "docusaurus start --host 0.0.0.0 --port 3000",
    "dev:open": "docusaurus start --host 0.0.0.0 --port 3000 --open",
    "dev:poll": "docusaurus start --host 0.0.0.0 --port 3000 --poll 1000",
    "debug": "NODE_OPTIONS='--inspect' docusaurus start --host 0.0.0.0 --port 3000",
    "debug:brk": "NODE_OPTIONS='--inspect-brk' docusaurus start --host 0.0.0.0 --port 3000",
    "start": "docusaurus start --host 0.0.0.0 --port 3000",
    "build": "docusaurus build",
    "build:fast": "docusaurus build",
    "build:gh": "BASE_URL=/web-interview/ docusaurus build",
    "build:preview": "docusaurus build && docusaurus serve --port 3000",
    "serve": "docusaurus serve --port 3000",
    "preview": "docusaurus serve --port 3000",
    "clear": "docusaurus clear",
    "clean": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "git diff --cached --name-only --diff-filter=ACM | xargs eslint",
    "lint:all": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "check": "npm run typecheck && npm run lint:all && npm run build",
    "swizzle": "docusaurus swizzle",
    "deploy": "./scripts/deploy.sh",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "prepare": "husky",
    "demo:tfo": "node docs/network/tcp/examples/tfo.js",
    "topics": "./scripts/topics.sh",
    "question:lint": "node scripts/question-lint.js",
    "question:lint:changed": "node scripts/question-lint.js --changed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenHeart/web-interview.git"
  },
  "keywords": [
    "interview",
    "web"
  ],
  "author": "zenheart",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zenHeart/web-interview/issues"
  },
  "homepage": "https://github.com/zenHeart/web-interview#readme",
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/eslint-parser": "^7.26.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-private-property-in-object": "^7.25.9",
    "@babel/preset-env": "^7.26.7",
    "@babel/preset-react": "^7.26.3",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/markdown": "^6.2.2",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chai": "^4.2.0",
    "eslint": "^8.5.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-mdx": "^3.1.5",
    "eslint-plugin-react": "^7.37.4",
    "husky": "^9.1.6",
    "lerna": "^3.14.1",
    "tapable": "^2.2.1",
    "typescript": "~5.6.2",
    "virtual-dom": "^2.1.1"
  },
  "dependencies": {
    "@chatui/core": "^3.1.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-live-codeblock": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "fast-glob": "^3.3.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "prism-react-renderer": "^2.3.0",
    "raw-loader": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "vue": "^3.5.13"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "pnpm": {
    "patchedDependencies": {
      "@easyops-cn/docusaurus-search-local": "patches/@easyops-cn__docusaurus-search-local.patch"
    }
  }
}
